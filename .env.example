# Exact origin used in your browser; deployed example: https://runners.aibrylabs.com
APP_URL=http://localhost:3000

# Connected browsing/Auth/orders. Leave both public fields empty for offline browsing.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only: private demos, onboarding/Storage, privileged payments and administration.
SUPABASE_SERVICE_ROLE_KEY=

# Genuine PayPal Sandbox tests only; simulation needs none of these credentials.
# All three must belong to the same Sandbox REST app and webhook registration.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# Optional provider AI. Without a key, discovery uses a labeled deterministic fallback.
# Choose a model available to this provider account; HTTPS is required.
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=

# Optional demo entry/switch kill switch. The database setting also revokes active demos.
# DEMO_MODE_ENABLED=false

# Application notifications (server only; use a verified Resend sender).
# Supabase Auth verification/recovery emails have separate Supabase SMTP settings.
RESEND_API_KEY=
ONBOARDING_EMAIL_FROM=
# Fixed platform administrator recipient; configuration must match this address.
ONBOARDING_EMAIL_TO=aibrymusic@gmail.com
# Vercel authenticates the daily retry worker with this secret.
CRON_SECRET=
# Optional delivery/bounce events from Resend; configure the matching webhook too.
RESEND_WEBHOOK_SECRET=

# Legacy local fixture seed only. Never use a real account password.
# DEMO_SEED_PASSWORD=
